# ─── AURA configuration template ───────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
#     cp .env.example .env

# ── VENTUNO Q board (on-device deployment target) ──
# Host/IP of the board and the SSH user used by scripts/run_device.sh.
AURA_BOARD_HOST=
AURA_BOARD_USER=
# Leave the password OUT of this file. Use an SSH key or a password manager.
# AURA_BOARD_KEY=~/.ssh/aura_ventuno

# ── Memory store (Milestone 3) ──
# SQLite file for events + object locations; vector store dir for embeddings.
AURA_DB_PATH=./aura.db
AURA_VECTOR_DIR=./.chroma

# ── Local LLM (Milestone 4) ──
# OpenAI-compatible endpoint of an on-device llama.cpp / Genie server.
# For the Qualcomm NPU path, point this at the aura.agent.genie_server shim
# running on the device (see docs/NPU_SETUP.md), e.g.:
#   AURA_LLM_BASE_URL=http://<device-ip>:8080
#   AURA_LLM_MODEL=qwen3-4b-npu
# Or point it at a GenieX server (geniex serve) with a Qwen3 NPU model:
#   AURA_LLM_BASE_URL=http://127.0.0.1:18181
#   AURA_LLM_MODEL=qualcomm/Qwen3-8B
AURA_LLM_BASE_URL=http://127.0.0.1:8080
AURA_LLM_MODEL=gemma-2-2b-it
# Disable Qwen3 "thinking" mode (appends /no_think to the prompt). Set true for
# reasoning models like Qwen3 that otherwise emit long <think> blocks and can
# loop until max_tokens. Harmless for non-reasoning models.
AURA_LLM_NO_THINK=false

# ── Genie NPU shim (aura.agent.genie_server, runs ON the device) ──
# Path to the Genie CLI runner and the model bundle's config on the device.
# AURA_GENIE_BIN=/opt/aura-llm/genie-t2t-run

# ── Vision (Milestone 1) ──
# Camera index or device path, and the YOLO ONNX model to load.
AURA_CAMERA=0
AURA_YOLO_MODEL=./models/yolov8n.onnx

# ── Speech (Milestone 2) ──
# Whisper model size (tiny/base/small) and TTS voice.
AURA_WHISPER_MODEL=base
AURA_TTS_VOICE=EN-default

# ── Dashboard ──
AURA_DASHBOARD_HOST=127.0.0.1
AURA_DASHBOARD_PORT=8000
