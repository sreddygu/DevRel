# ─── AURA configuration template ───────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real secrets.
#     cp .env.example .env

# ── VENTUNO Q board (on-device deployment target) ──
# Host/IP of the board and the SSH user used by scripts/run_device.sh.
AURA_BOARD_HOST=
AURA_BOARD_USER=
# Leave the password OUT of this file. Use an SSH key or a password manager.
# AURA_BOARD_KEY=~/.ssh/aura_ventuno

# ── Memory store (Milestone 3) ──
# SQLite file for events + object locations; vector store dir for embeddings.
AURA_DB_PATH=./aura.db
AURA_VECTOR_DIR=./.chroma

# ── Local LLM (Milestone 4) ──
# OpenAI-compatible endpoint of an on-device llama.cpp / Genie server.
# For a legacy Genie CLI runner, point this at the aura.agent.genie_server shim
# running on the device (see docs/NPU_SETUP.md), e.g.:
#   AURA_LLM_BASE_URL=http://<device-ip>:8080
#   AURA_LLM_MODEL=qwen3-4b-npu
# Tested IQ9/QCS9075 profile: native GenieX QAIRT server + Gemma 4 E4B W4A16.
# See docs/IQ9_GEMMA4_GENIE_QAIRT.md.
#   AURA_LLM_BASE_URL=http://<iq9-ip>:18181
#   AURA_LLM_MODEL=qualcomm/Gemma-4-E4B-it:W4A16
# Tested Snapdragon X Elite profile: GenieX llama.cpp + Gemma 4 E4B Q4_0.
# See docs/PI_GENIEX.md.
#   AURA_LLM_BASE_URL=http://127.0.0.1:18181
#   AURA_LLM_MODEL=google/gemma-4-E4B-it-qat-q4_0-gguf:Q4_0
AURA_LLM_BASE_URL=http://127.0.0.1:8080
AURA_LLM_MODEL=gemma-2-2b-it
# Disable Qwen3 "thinking" mode (appends /no_think to the prompt). Set true for
# reasoning models like Qwen3 that otherwise emit long <think> blocks and can
# loop until max_tokens. Harmless for non-reasoning models.
AURA_LLM_NO_THINK=false

# ── Genie NPU shim (aura.agent.genie_server, runs ON the device) ──
# Path to the Genie CLI runner and the model bundle's config on the device.
# AURA_GENIE_BIN=/opt/aura-llm/genie-t2t-run

# ── ExecuTorch warm pipe host (Snapdragon X Elite, native named-pipe host) ──
# Backend selector for aura-executorch-server: "runner" (reload llama_main per
# call, default) or "pipe-host" (keep qnn_llm_host.exe warm and serve over a
# Windows named pipe — model + QNN context loaded once). See docs/PI_PIPE_HOST.md.
# The host binary + QNN backend DLLs ship under ./bin/ (see bin/README.md); the
# Gemma-4 .pte goes under ./models/ (see models/README.md). Only QNN_SDK_ROOT is
# machine-specific — point it at your installed QAIRT SDK.
# AURA_LLM_BACKEND=pipe-host
# AURA_HOST_BIN=./bin/qnn_llm_host.exe
# AURA_MODEL_PATH=./models/gemma4_e2b_sc8380xp_ctxt_4000_ar_l-128/gemma4_e2b_sc8380xp_ctxt_4000-001.pte
# AURA_TOKENIZER_PATH=./models/gemma4_e2b_sc8380xp_ctxt_4000_ar_l-128/tokenizer.json
# AURA_PIPE_NAME=gemma4
# AURA_DECODER_MODEL_VERSION=gemma4
# AURA_SEQ_LEN_CEILING=3800
# AURA_QNN_SDK_ROOT=C:\Qualcomm\AIStack\QAIRT\2.47.1.260610
# AURA_QNN_BACKEND_DIR=./bin/RelWithDebInfo
# AURA_HEXAGON_ARCH=73

# ── Vision (Milestone 1) ──
# Camera index or device path, and the YOLO ONNX model to load.
AURA_CAMERA=0
AURA_YOLO_MODEL=./models/yolov8n.onnx

# ── Speech (Milestone 2) ──
# Whisper model size (tiny/base/small) and TTS voice.
AURA_WHISPER_MODEL=base
AURA_TTS_VOICE=EN-default

# ── Dashboard ──
AURA_DASHBOARD_HOST=127.0.0.1
AURA_DASHBOARD_PORT=8000

# ── Robot / Milestone 5 (VENTUNO Q) ──
# ROS2 /cmd_vel topic and SafeRobotController safety limits.
# Increase AURA_ROBOT_MAX_DURATION cautiously — default 2 s is a hard safety ceiling.
AURA_ROBOT_TOPIC=/cmd_vel
AURA_ROBOT_MAX_LINEAR_SPEED=0.25
AURA_ROBOT_MAX_ANGULAR_SPEED=0.75
AURA_ROBOT_MAX_DURATION=2.0
# GPIO sysfs pin number for the physical emergency-stop button wired to the MCU.
# Set to the pin number (e.g. 17) to enable background polling; 0 = disabled.
# The button must pull the GPIO line LOW when pressed (active-low assumed).
AURA_ROBOT_EMERGENCY_GPIO=0
