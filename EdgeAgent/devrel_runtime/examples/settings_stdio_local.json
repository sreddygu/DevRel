{
  "permissions": {
    "allow": [
      "mcp__devrel__hardware_detect",
      "mcp__devrel__convert_model",
      "mcp__devrel__profile_workload",
      "mcp__devrel__orchestrate_workload",
      "mcp__devrel__generate_code"
    ]
  },
  "mcpServers": {
    "devrel": {
      "command": "python",
      "args": ["-m", "devrel.mcp.server"],
      "cwd": "${workspaceFolder}",
      "env": {
        "DevRel_ADAPTER_MODE": "mock"
      }
    }
  }
}
