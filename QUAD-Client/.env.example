# QUAD-Client environment template — COMMIT this file (blank placeholders only).
# Copy to .env and fill in real values. .env itself is gitignored.

# Qualcomm AI Hub API token (https://app.aihub.qualcomm.com -> Account -> API token).
# QAI_HUB_API_KEY is canonical (matches quad.toml [adapters.ai_hub] api_key_env).
# QAI_HUB_API_TOKEN is an alias read by SAGE-style apps / fetch_llm_model.py.
# CRITICAL fallback: when the QUAD MCP server's convert_model/profile_workload
# tools are unavailable (see the MCP registration note in CLAUDE.md), this key
# is what lets model conversion/profiling proceed directly against AI Hub
# Models' cloud compiler instead of blocking it.
QAI_HUB_API_KEY=
QAI_HUB_API_TOKEN=

# Hugging Face token — only needed to download GATED base weights (Llama/Qwen)
# when BUILDING an NPU LLM bundle. Open models (e.g. Falcon3) need no HF token.
# HF_TOKEN=

# ── Remote QUAD MCP server ───────────────────────────────────────────────────
# Set these to connect to a remote QUAD MCP server over HTTP/SSE. QUAD_MCP_TOKEN
# is the bearer token the server was started with (they must match); QUAD_MCP_URL
# is the server endpoint. Both are unnecessary for a local stdio server, which
# the client spawns itself. Generate a token with:  openssl rand -hex 32
QUAD_MCP_URL=
QUAD_MCP_TOKEN=
