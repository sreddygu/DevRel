# QUAD-Client board-connection template — COMMIT this file (blank placeholders only).
# Copy to .env_boards and fill in real values. .env_boards itself is gitignored
# (see .gitignore) so board IPs/passwords never get committed.
#
# Purpose: SSH is now the primary transport for on-device work (~95% of
# workflows) on Qualcomm Linux dev boards like the IQ-9075 EVK — see
# docs/debugging/IQ9075_adb_investigation.md for why ADB was de-prioritized.
# "SSH into the board" is Step 1 before running inference; these vars back
# that step instead of hardcoding host/user/password into scripts each time.

# ═════════════════════════════════════════════════════════════════════════
# IQ-9075 EVK (Dragonwing, SoC QCS9075) — QLI 2.0 GA build
# ═════════════════════════════════════════════════════════════════════════
# Board access is SSH-first. ADB is a secondary/bootstrap-only transport
# (only useful before WiFi is up on a freshly flashed board) — see
# docs/debugging/IQ9075_adb_investigation.md for the full investigation and
# scripts/board_profile.py (--transport ssh|adb) for the CLI-level switch.

# Board IP — set after connecting the board to WiFi (see docs/IQ9075_SOPs.md).
# Qualcomm corporate WiFi and other networks hand out different ranges; the
# value below is only an example, not a fixed address for every session.
# CONSUMED DIRECTLY by quad.toml's [target.iq-9075.ssh] host = "${env:IQ9075_HOST}"
# -- required for /quad-detect's SSH target discovery (step 3) to resolve
# this board at all. Left unset, that stanza resolves to an empty host, not
# an error -- see docs/debugging/Fresh_Terminal_EnvBoards_Sourcing_Gap.md.
IQ9075_HOST=

# SSH login. root / oelinux123 is the QLI 2.0 GA default if you haven't set
# your own password during first login.
# IQ9075_SSH_USER is CONSUMED DIRECTLY by quad.toml's [target.iq-9075.ssh]
# user = "${env:IQ9075_SSH_USER}" -- same required-for-discovery note as
# IQ9075_HOST above. IQ9075_SSH_PASSWORD is used only by the plink.exe
# invocation documented in CLAUDE.md's "Board connect (IQ-9075)" section
# (not read by quad.toml/quad-detect).
IQ9075_SSH_USER=root
IQ9075_SSH_PASSWORD=

# Windows OpenSSH's client fails with "Permission denied (publickey,password)"
# against this board's interactive password prompt — use PuTTY's plink.exe
# instead (path below), or switch to key-based auth once a key is provisioned.
IQ9075_PLINK_PATH=C:\Program Files\PuTTY\plink.exe

# SSH host key fingerprint — changes on every reflash. plink will print the
# new fingerprint on first connect after a reflash; re-accept and update this
# value then. Leave blank to accept-on-first-use instead of pinning.
IQ9075_SSH_HOST_KEY_FINGERPRINT=

# UART/serial fallback (bring-up before WiFi/SSH is available).
IQ9075_UART_COM_PORT=
IQ9075_UART_BAUD=115200
