Thumbs.db

# Project-local generated files
.claude/settings.local.json
*.log
.env.local

# QUAD runtime state (sdk_manager.write_state_file output, etc.)
.quad/
# QUAD portable environment (SDK junction, QAIRT Python venv, etc.)
.QUAD/

# Downloaded / generated model artifacts (created by sample scripts)
*.onnx
*.onnxsim_done
*.bin
*.dlc
*.raw
*.tflite
imagenet_classes.txt
output/

# User-supplied test images checked out alongside samples
samples/**/*.jpg
samples/**/*.jpeg
samples/**/*.png
samples/**/*.bmp
samples/**/*.webp
# ...but keep the committed default test image for each sample
!samples/mobilenetv2/test_input.jpg
!samples/mobilenetv2_npu_iq9075/test_input.jpg
# ...and keep placeholder / fixture images that are intentionally in the repo
!samples/**/fixture_*

# Claude Code provisioning output (created by quad-client install)
# Skills and settings are source — only ignore runtime/local state.
.claude/settings.local.json
.claude/mcp.json

# opencode provisioning output (created by quad-client install --client opencode)
# opencode.json is committed as a portable default; ignore runtime/local state.
.opencode/
opencode.local.json

# ── Third-party / vendored build artifacts (fetched on demand, never committed) ──
# OpenWrt's ipkg-build packaging script — downloaded by each sample build.sh
# from the OpenWrt upstream when missing (external authorship/licensing;
# must not ship in this repo). See samples/gwapps_fault_detection/README.md.
samples/**/ipkg-build
# Cross-compile toolchain configs — operator-supplied from their own SDK; the
# committed copies were vendored templates flagged by open-source review.
samples/**/*-toolchain.cmake
# ImageNet-1k class labels — public dataset artifact auto-downloaded from
# PyTorch Hub by the mobilenetv2 sample scripts (run_mobilenetv2.py etc.).
samples/**/imagenet_classes.txt


# (Internal) RCA 
docs/debugging/*
# scripts/board_profile.py
samples/mobilenetv2_iq9075/* 
.venv-arm64/
**/onnxruntime_profile_*.json
