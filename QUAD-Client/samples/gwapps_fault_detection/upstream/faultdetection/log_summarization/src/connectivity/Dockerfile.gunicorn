FROM docker-registry.qualcomm.com/library/python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1


RUN addgroup --system appgroup && adduser --system --ingroup appgroup --uid 10001 appuser

RUN mkdir -p /app/logs && chown -R appuser:appgroup /app/logs

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn "uvicorn[standard]"

COPY --chown=appuser:appgroup . .
RUN python -m compileall . -b



FROM docker-registry.qualcomm.com/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN addgroup --system appgroup && adduser --system --ingroup appgroup --uid 10001 appuser

RUN mkdir -p /app/logs && chown -R appuser:appgroup /app/logs

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn "uvicorn[standard]"

COPY --from=builder  --chown=appuser:appgroup  /app/*.pyc /app/
COPY --from=builder  --chown=appuser:appgroup  /app/*.txt /app/
COPY --from=builder  --chown=appuser:appgroup  /app/agentic_service /app/agentic_service

# Copy entrypoint script and gunicorn config
COPY --chown=appuser:appgroup entrypoint.sh /app/entrypoint.sh
COPY --chown=appuser:appgroup gunicorn_conf.py /app/gunicorn_conf.py
RUN chmod +x /app/entrypoint.sh

ARG LOG_SUMMARIZATION_DATA_DIR=/local/mnt/log_summarization_api_data

# Create default data dir (bind mount may overlay)
RUN mkdir -p "${LOG_SUMMARIZATION_DATA_DIR}" && chown -R appuser:appgroup "${LOG_SUMMARIZATION_DATA_DIR}"

RUN chmod -R a+rX /app

RUN chmod -R a+rX "${LOG_SUMMARIZATION_DATA_DIR}"


USER appuser

EXPOSE 8000
ENV WORKERS=2 \
    TIMEOUT=600

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["gunicorn", "--chdir", "/app", "-c", "gunicorn_conf.py", "main:app"]
