# Local model artifacts (large and machine-specific)
/models/
*.pte
*.pt
*.pth
*.onnx
*.gguf

# Locally built QNN host and runner binaries
/RelWithDebInfo/
/qnn_*.exe

# Generated runtime state and diagnostics
/.roboagent-runtime/
/logs/*
!/logs/README.md

# Local Pi state; project-specific skills under .pi/skills remain tracked
/.pi/sessions/
/.pi/state/
/.pi/history/

# Dependencies and virtual environments
/node_modules/
/.venv/
/.venv_x64/
/.venv_qairt/
__pycache__/
*.py[cod]

# Test and tool caches
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/coverage/
.coverage

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Outputs and execution data (managed; do not commit run results) ---
# Run output folders
output/
outputs/
results/
runs/
artifacts/
tmp/
temp/
checkpoints/
exports/
.cache/
# Logs, local databases and process files
*.log
*.log.*
*.pid
*.db
*.sqlite
*.sqlite3
*.executed.ipynb
.ipynb_checkpoints/
# Models, compiled graphs and generated binaries
*.onnx.data
*.dlc
*.tflite
*.joblib
*.npy
*.npz
*.bin
*.raw
# Environments, caches and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example
!.env.*.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
