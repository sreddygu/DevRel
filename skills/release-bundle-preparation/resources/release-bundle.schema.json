{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P3 Synapse release bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "version",
    "channel",
    "source",
    "delivery_model",
    "compatibility",
    "skills",
    "assets",
    "validation",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "channel": {"enum": ["incubating", "preview", "stable", "lts"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "released_on"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7},
        "released_on": {"type": "string", "format": "date"}
      }
    },
    "delivery_model": {"enum": ["source-skill-pack", "installable-starter-kit", "device-ready-release-kit"]},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "devices", "known_exclusions"],
      "properties": {
        "hosts": {"type": "array", "items": {"type": "string"}},
        "devices": {"type": "array", "items": {"type": "string"}},
        "known_exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "retrieval", "sha256", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "retrieval": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "license": {"type": "string", "minLength": 1},
          "redistributable": {"type": "boolean"}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "evidence"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_gates", "rollback", "secrets_policy"],
      "properties": {
        "approval_gates": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "string", "minLength": 1},
        "secrets_policy": {"type": "string", "minLength": 1}
      }
    }
  }
}
